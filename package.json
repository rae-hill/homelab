{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "lib/*"
  ],
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "seed:test-secrets": "node scripts/stage-test-secrets.mjs && node scripts/stage-e2e-secrets.mjs",
    "build": "yarn workspaces foreach -Apt run build",
    "typecheck": "yarn workspaces foreach -Apt run typecheck",
    "test": "yarn workspaces foreach -Apt run test",
    "test:staged": "yarn workspaces foreach -Apt run test:staged",
    "lint": "yarn workspaces foreach -Apt run lint",
    "circular": "yarn workspaces foreach -Apt run circular",
    "release": "multi-semantic-release",
    "typecheck:libs": "yarn workspaces foreach -Apt --include '@rae-hill/*' run typecheck",
    "lint:libs": "yarn workspaces foreach -Apt --include '@rae-hill/*' run lint",
    "test:libs": "yarn workspaces foreach -Apt --include '@rae-hill/*' run test",
    "prepare": "husky",
    "postinstall": "yarn-berry-fetcher missing-hashes yarn.lock 2>/dev/null | grep -v '^CacheKey\\|^Success\\|^$' > missing-hashes.json"
  },
  "devDependencies": {
    "@anolilab/multi-semantic-release": "4.6.3",
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@effect/build-utils": "^0.8.9",
    "@effect/eslint-plugin": "0.3.2",
    "@effect/language-service": "latest",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/debug": "^4",
    "@types/node": "^22.19.11",
    "@typescript-eslint/utils": "8.60.0",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "debug": "^4.4.3",
    "effect": "^4.1.x",
    "eslint": "10.4.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-codegen": "0.34.1",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "fast-check": "^4.5.3",
    "glob": "^11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "semantic-release": "25.0.9",
    "tsc-files": "^1.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.60.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0"
  },
  "resolutions": {
    "@astrojs/solid-js@npm:6.0.1/solid-devtools": "0.34.5"
  }
}
