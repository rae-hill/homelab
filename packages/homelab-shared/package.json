{
  "name": "homelab-shared",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Shared constants and utilities for homelab services",
  "repository": {
    "type": "git",
    "url": "<PLACEHOLDER>",
    "directory": "packages/homelab-shared"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "circular": "yarn madge --circular ./src/index.ts",
    "lint": "eslint src",
    "typecheck": "tsc -b tsconfig.json --noEmit",
    "test": "vitest run",
    "test:staged": "vitest related --run",
    "test:watch": "vitest watch",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.x",
    "bufferutil": "^4.1.0",
    "effect": "^4.1.x",
    "type-fest": "^5.4.4",
    "utf-8-validate": "^6.0.6"
  },
  "effect": {
    "generateExports": {
      "include": [
        "**/*.ts"
      ]
    },
    "generateIndex": {
      "include": [
        "**/*.ts"
      ]
    }
  },
  "devDependencies": {
    "@effect/vitest": "^4.1.x",
    "@types/node": "^24",
    "madge": "^8.0.0",
    "vitest": "^5.x"
  }
}
