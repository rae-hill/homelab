# Homelab integration (all values PUBLIC — baked into the bundle at build time).
# The API is tailscale-only; the reachability probe keeps the UI dark off-tailnet.
VITE_HOMELAB_API_URL=https://homelab-api.plato-splunk.media
# Kanidm client-scoped discovery base for the shared "homelab" PKCE client
# (oidc-client-ts appends /.well-known/openid-configuration).
VITE_OIDC_AUTHORITY=https://idm.plato-splunk.media/oauth2/openid/homelab
VITE_OIDC_CLIENT_ID=homelab
